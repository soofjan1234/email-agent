# OpenAI-compatible embedding gateway. Copy to .env and fill locally.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.ztoken.pro/v1

# 优先复用本机 PostgreSQL；凭据只填写在忽略的 .env 中。
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/email_agent
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/email_agent_snowflake_test
# Docker Desktop 内通过 host.docker.internal 访问同一个本机数据库。
MVP_DATABASE_URL=postgresql+psycopg://postgres:change-me@host.docker.internal:5432/email_agent
MVP_TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@host.docker.internal:5432/email_agent_snowflake_test

# 首次启动前准备 inbox/ 和 sent/；原生及容器使用同一个邮箱标识。
MAILBOX_ID=local-mock
MAILBOX_ROOT=data/mock-mailbox
MAIL_SYNC_PAGE_SIZE=100
WORKER_POLL_SECONDS=2

# 默认仍使用公开模拟夹具；切换真实邮箱时只把凭据写入被忽略的 .env。
MAILBOX_ADAPTER=mock
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX_FOLDER=INBOX
IMAP_SENT_FOLDER=

# 运行时导入此目录内的 UTF-8 Markdown；容器映射为 /app/data/knowledge。
KNOWLEDGE_ROOT=data/knowledge
KNOWLEDGE_SOURCE_ID=local-products
KNOWLEDGE_MAX_BYTES=2000000
# 仅在本地测试或开发时开启服务器路径导入；生产应保持 false。
KNOWLEDGE_LOCAL_IMPORT_ENABLED=true

# Snowflake 仅为开发候选，此索引不代表生产冻结。
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v1.5
EMBEDDING_REVISION=e58a8f756156a1293d763f17e3aae643474e9b8a
EMBEDDING_DIMENSIONS=768
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_DOCUMENT_PREFIX=""
EMBEDDING_INDEX_VERSION=dev-snowflake-m-v1.5-001
EMBEDDING_BASE_URL=http://127.0.0.1:18080
MVP_EMBEDDING_BASE_URL=http://host.docker.internal:18080

# B2 OpenAI-compatible 生成服务；未配置时邮件安全转人工，不生成确定方案。
GENERATOR_BASE_URL=
GENERATOR_API_KEY=
GENERATOR_MODEL=
GENERATOR_TIMEOUT_SECONDS=90
VIP_ADDRESSES=
